{
  "expo": {
    "name": "UNI",
    "slug": "uni",
    "scheme": "uni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acasalini.uni",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "d378862c-0de6-4976-ad04-3fd75bf648f6"
      }
    }
  }
}
