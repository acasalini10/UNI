{
  "expo": {
    "name": "UNI",
    "slug": "uni",
    "scheme": "uni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acasalini.uni",
      "usesAppleSignIn": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      "expo-apple-authentication"
    ]
  }
}
