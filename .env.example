# Copy this file to .env and replace the fake values. Never commit .env (it is in .gitignore).
# In Codespaces, set these as Codespaces secrets instead.

# --- App (Expo). Public values: they are bundled into the app. ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# --- Edge Functions (server only). Not read from this file by the app. ---
# Set with: npx supabase secrets set ANTHROPIC_API_KEY=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
